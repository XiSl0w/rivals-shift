{
  "name": "rival-shift",
  "version": "0.9.49",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "author": "Rival Shift contributors",
  "description": "A focused Steam account switcher for Marvel Rivals with Rivals Data profile cards.",
  "main": "dist-electron/main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:live": "electron scripts/test-rivals-electron.cjs",
    "dist": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File builders/build-installer.ps1",
    "release:latest": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File builders/release-latest.ps1",
    "release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File builders/build-and-release.ps1"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rivalsdata-player-sdk": "file:vendor/rivalsdata-player-sdk"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.rivalshift.app",
    "productName": "Rival Shift",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "XiSl0w",
        "repo": "rivals-shift"
      }
    ],
    "files": [
      "dist/**/*",
      "!dist/stretched-resolution/**/*",
      "dist-electron/**/*",
      "extension/**/*",
      "vendor/rivalsdata-player-sdk/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "extension/**/*",
      "dist/rivals-rush-icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Rival-Shift-Payload-${version}.${ext}"
    }
  }
}
