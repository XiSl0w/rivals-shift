{
  "name": "rivalsdata-player-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript SDK for Rivals Data player endpoints.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
